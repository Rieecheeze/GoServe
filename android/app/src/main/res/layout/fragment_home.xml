<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gs_background">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/toolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/gs_toolbar_height" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <ImageView android:id="@+id/appLogo" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="20dp" android:src="@drawable/goserve_logo" android:scaleType="fitCenter" android:contentDescription="@string/app_name" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <ImageButton android:id="@+id/notificationsButton" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:src="@drawable/ic_notifications" android:contentDescription="@string/notifications" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/toolbar" app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/gs_content_margin" android:paddingEnd="@dimen/gs_content_margin" android:paddingTop="8dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/previewNotice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_muted" android:padding="12dp" android:text="@string/preview_notice" android:textAppearance="@style/TextAppearance.GoServe.Caption" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:id="@+id/heroTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/home_hero" android:textAppearance="@style/TextAppearance.GoServe.Heading" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/previewNotice" />
            <TextView android:id="@+id/heroSubtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_subtitle" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/heroTitle" />
            <com.google.android.material.button.MaterialButton android:id="@+id/searchButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:minHeight="52dp" android:text="@string/search_offices" android:textColor="@color/gs_secondary" android:gravity="start|center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingBottom="14dp" app:icon="@drawable/ic_search" app:iconTint="@color/gs_secondary" app:iconPadding="12dp" app:iconSize="24dp" app:cornerRadius="17dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/heroSubtitle" />
            <HorizontalScrollView android:id="@+id/serviceFilters" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:scrollbars="none" android:fillViewport="false" android:clipToPadding="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/searchButton">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/allServicesButton" style="@style/Widget.GoServe.Button.Filter.Selected" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/all_services" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/documentsButton" style="@style/Widget.GoServe.Button.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/documents" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/paymentsButton" style="@style/Widget.GoServe.Button.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/payments" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/consultButton" style="@style/Widget.GoServe.Button.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/consultations" />
                </LinearLayout>
            </HorizontalScrollView>
            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/activeRequestCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_active_request" android:padding="16dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/serviceFilters">
                <TextView android:id="@+id/requestLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:text="@string/active_request" android:textAppearance="@style/TextAppearance.GoServe.Caption" android:textColor="@color/gs_on_primary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/requestStatus" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/requestStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textAppearance="@style/TextAppearance.GoServe.Caption" android:textColor="@color/gs_text" app:layout_constraintWidth_max="150dp" app:layout_constrainedWidth="true" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <androidx.constraintlayout.widget.Barrier android:id="@+id/requestHeaderBottom" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="requestLabel,requestStatus" />
                <TextView android:id="@+id/requestTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textAppearance="@style/TextAppearance.GoServe.Heading.Section" android:textColor="@color/gs_on_primary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/requestHeaderBottom" />
                <TextView android:id="@+id/requestMeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textAppearance="@style/TextAppearance.GoServe.Caption" android:textColor="@color/gs_on_primary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/requestTitle" />
                <com.google.android.material.button.MaterialButton android:id="@+id/requestDetailsButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="48dp" android:text="@string/view_request" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingStart="12dp" android:paddingEnd="12dp" app:cornerRadius="24dp" app:layout_constrainedWidth="true" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0" app:layout_constraintTop_toBottomOf="@id/requestMeta" app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView android:id="@+id/officesTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginEnd="12dp" android:text="@string/campus_offices" android:textAppearance="@style/TextAppearance.GoServe.Heading.Section" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/seeAllButton" app:layout_constraintTop_toBottomOf="@id/activeRequestCard" />
            <com.google.android.material.button.MaterialButton android:id="@+id/seeAllButton" style="@style/Widget.GoServe.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/see_all" android:paddingStart="10dp" android:paddingEnd="10dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/activeRequestCard" />
            <androidx.constraintlayout.widget.Barrier android:id="@+id/officesHeaderBottom" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="officesTitle,seeAllButton" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/officesRecycler" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="false" android:clipToPadding="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/officesHeaderBottom" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintVertical_bias="0" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
