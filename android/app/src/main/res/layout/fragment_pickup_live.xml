<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/gs_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/pickupBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <TextView android:id="@+id/pickupTitle" style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/pickup_title" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/pickupScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/pickupContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/pickupHeading" style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pickup_heading" />
            <TextView android:id="@+id/pickupReference" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
            <TextView android:id="@+id/pickupService" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/pickupPayment" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/gs_secondary" />
            <TextView android:id="@+id/pickupBody" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/pickupQrCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:gravity="center_horizontal" android:padding="20dp" android:background="@drawable/bg_request_record" android:visibility="gone">
                <ImageView android:id="@+id/pickupQrImage" android:layout_width="220dp" android:layout_height="220dp" android:maxWidth="220dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="@string/pickup_qr_description" />
                <TextView android:id="@+id/pickupCode" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:fontFamily="monospace" android:saveEnabled="false" />
                <TextView android:id="@+id/pickupExpiry" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/gs_secondary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/pickupInputCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/pickupScan" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:text="@string/pickup_scan" />
                <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/pickup_input_label" android:labelFor="@id/pickupInput" />
                <EditText android:id="@+id/pickupInput" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:maxLength="128" android:inputType="textVisiblePassword|textNoSuggestions" android:hint="@string/pickup_input_hint" android:saveEnabled="false" android:importantForAutofill="no" android:imeOptions="flagNoPersonalizedLearning" />
            </LinearLayout>
            <TextView android:id="@+id/pickupMessage" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/pickupLoading" android:layout_width="match_parent" android:layout_height="56dp" android:importantForAccessibility="no" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/pickupEdit" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:text="@string/pickup_edit" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/pickupRefresh" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:text="@string/pickup_refresh" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/pickupPrimary" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:text="@string/pickup_issue" />
</LinearLayout>
