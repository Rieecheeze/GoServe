<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gs_background">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/passwordToolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/gs_toolbar_height" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/passwordBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <TextView android:id="@+id/passwordHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="20dp" android:layout_marginVertical="16dp" android:text="@string/password_change_title" android:textAppearance="@style/TextAppearance.GoServe.Heading.Toolbar" app:layout_constraintStart_toEndOf="@id/passwordBack" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/passwordScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/passwordToolbar" app:layout_constraintBottom_toTopOf="@id/passwordFooter">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/gs_content_margin" android:paddingTop="16dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/passwordIntro" style="@style/Widget.GoServe.Account.Support" android:text="@string/password_change_intro" />
            <TextView style="@style/Widget.GoServe.Account.Label" android:text="@string/password_current" android:labelFor="@id/currentPasswordInput" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/currentPasswordBox" style="@style/Widget.GoServe.Account.PasswordBox" android:saveEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/currentPasswordInput" style="@style/Widget.GoServe.Account.PasswordInput" android:hint="@string/password_current" android:autofillHints="password" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/Widget.GoServe.Account.Label" android:text="@string/password_new" android:labelFor="@id/newPasswordInput" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/newPasswordBox" style="@style/Widget.GoServe.Account.PasswordBox" android:saveEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/newPasswordInput" style="@style/Widget.GoServe.Account.PasswordInput" android:hint="@string/password_new" android:autofillHints="newPassword" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/Widget.GoServe.Account.Support" android:text="@string/account_password_rule" android:layout_marginTop="8dp" />
            <TextView style="@style/Widget.GoServe.Account.Label" android:text="@string/account_password_confirmation" android:labelFor="@id/newPasswordConfirmation" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/newPasswordConfirmationBox" style="@style/Widget.GoServe.Account.PasswordBox" android:saveEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/newPasswordConfirmation" style="@style/Widget.GoServe.Account.PasswordInput" android:hint="@string/account_password_confirmation_hint" android:autofillHints="newPassword" android:imeOptions="actionDone" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:id="@+id/passwordCodePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/passwordCodeIntro" style="@style/Widget.GoServe.Account.Support" android:layout_marginTop="24dp" android:text="@string/password_code_intro" />
                <com.google.android.material.button.MaterialButton android:id="@+id/passwordSendCode" style="@style/Widget.GoServe.Account.Button.Text" android:text="@string/password_send_code" />
                <TextView android:id="@+id/passwordCodeStatus" style="@style/Widget.GoServe.Account.Support" android:text="@string/password_code_requested" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                <TextView style="@style/Widget.GoServe.Account.Label" android:text="@string/password_email_code" android:labelFor="@id/passwordCodeInput" />
                <androidx.appcompat.widget.AppCompatEditText android:id="@+id/passwordCodeInput" style="@style/Widget.GoServe.Account.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/password_email_code" android:inputType="textNoSuggestions" android:importantForAutofill="no" android:imeOptions="actionDone" android:saveEnabled="false" />
            </LinearLayout>
            <TextView android:id="@+id/passwordChangeError" style="@style/Widget.GoServe.Account.Error" />
            <TextView android:id="@+id/passwordHelp" style="@style/Widget.GoServe.Account.Support" android:layout_marginTop="24dp" android:text="@string/password_change_help" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/passwordFooter" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/gs_background" android:paddingHorizontal="@dimen/gs_content_margin" android:paddingVertical="12dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/passwordChangeProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/passwordSaveButton" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_change_save" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
