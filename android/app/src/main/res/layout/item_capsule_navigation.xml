<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="48dp" android:minHeight="48dp" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="@drawable/bg_navigation_item">
    <FrameLayout android:layout_width="48dp" android:layout_height="40dp" android:importantForAccessibility="no" android:duplicateParentState="true">
        <View android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/bg_navigation_indicator" android:duplicateParentState="true" />
        <ImageView android:id="@+id/navigationIcon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/navigationItemLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.GoServe.Navigation" android:textColor="@color/capsule_navigation_text" android:gravity="center" android:importantForAccessibility="no" />
</LinearLayout>
