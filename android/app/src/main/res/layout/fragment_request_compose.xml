<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/composeBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <TextView style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/compose_title" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/composeScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/composeHeading" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/compose_heading" />
            <TextView android:id="@+id/composeOffice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/gs_secondary" />
            <TextView android:id="@+id/composeNotice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/composeLoading" android:layout_width="match_parent" android:layout_height="56dp" android:importantForAccessibility="no" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/composeCatalogueRetry" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/compose_catalogue_retry" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/composeCatalogueMore" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/compose_catalogue_more" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/composeQuoteRetry" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/compose_quote_retry" android:visibility="gone" />
            <LinearLayout android:id="@+id/composeForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_muted">
                <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/compose_fee_title" />
                <TextView android:id="@+id/composeFee" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/compose_fee_unselected" />
            </LinearLayout>
            <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/composeService" android:text="@string/compose_service_label" />
            <com.google.android.material.button.MaterialButton android:id="@+id/composeService" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/compose_service_choose" android:gravity="start|center_vertical" app:icon="@drawable/ic_expand_more" app:iconTint="@color/gs_text" app:iconGravity="end" />
            <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/composeDelivery" android:text="@string/compose_delivery_label" />
            <com.google.android.material.button.MaterialButton android:id="@+id/composeDelivery" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/compose_delivery_choose" android:gravity="start|center_vertical" app:icon="@drawable/ic_expand_more" app:iconTint="@color/gs_text" app:iconGravity="end" />
            <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/composeNotes" android:text="@string/compose_notes_label" />
            <EditText android:id="@+id/composeNotes" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:hint="@string/compose_notes_hint" android:inputType="textMultiLine|textCapSentences" android:gravity="top|start" android:importantForAutofill="no" android:saveEnabled="false" />
            <LinearLayout android:id="@+id/composePayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/compose_payment_title" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/composeCash" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.GoServe.Label" android:textColor="@color/gs_text" android:text="@string/compose_cash" android:saveEnabled="false" />
                <TextView android:id="@+id/composeCashNotice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/compose_cash_unavailable" android:textColor="@color/gs_secondary" android:visibility="gone" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/composeEgovpay" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.GoServe.Label" android:textColor="@color/gs_text" android:text="@string/egovpay_option" android:saveEnabled="false" />
                <TextView android:id="@+id/composeEgovpayNotice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/egovpay_unavailable" android:textColor="@color/gs_secondary" />
            </LinearLayout>
            <TextView style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/compose_evidence_title" />
            <TextView android:id="@+id/composeEvidence" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/gs_secondary" />
            <LinearLayout android:id="@+id/composeEvidenceFiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/composeAddEvidence" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/evidence_title" android:visibility="gone" />
            <TextView android:id="@+id/composeUploadNotice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/gs_secondary" android:text="@string/compose_upload_unavailable" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/composeReviewNotice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_muted" android:text="@string/compose_review_body" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/composeEdit" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/compose_edit" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/composeCheckRequests" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/compose_check_requests" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/composePrimary" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:text="@string/compose_review" android:textColor="@color/cash_action_foreground" app:backgroundTint="@color/cash_action_background" />
</LinearLayout>
