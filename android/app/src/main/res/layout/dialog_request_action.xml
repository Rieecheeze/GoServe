<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/gs_background" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/actionBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <TextView style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/action_title" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/actionScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_muted">
                <TextView android:id="@+id/actionReference" style="@style/TextAppearance.GoServe.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/actionService" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/actionStatus" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/gs_secondary" />
            </LinearLayout>
            <TextView android:id="@+id/actionNotice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/actionLoading" android:layout_width="match_parent" android:layout_height="56dp" android:importantForAccessibility="no" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/actionRetryOptions" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/action_retry_options" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/actionReload" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/action_reload" android:visibility="gone" />
            <TextView android:id="@+id/actionReasonLabel" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/actionReason" android:text="@string/action_reason" />
            <EditText android:id="@+id/actionReason" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:hint="@string/action_reason_hint" android:inputType="textMultiLine|textCapSentences" android:gravity="top|start" android:importantForAutofill="no" android:saveEnabled="false" />
            <LinearLayout android:id="@+id/actionChoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" />
            <TextView android:id="@+id/actionReview" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_muted" android:visibility="gone" />
            <TextView style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_muted" android:text="@string/action_payment_separate" android:textColor="@color/gs_secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/actionEdit" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/action_edit" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/actionConfirm" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:text="@string/action_confirm" android:textColor="@color/cash_action_foreground" app:backgroundTint="@color/cash_action_background" />
</LinearLayout>
