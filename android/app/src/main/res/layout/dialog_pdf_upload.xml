<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/gs_background" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@id/pdfBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <TextView style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/pdf_toolbar" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@id/pdfScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@id/pdfContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="24dp">
            <TextView style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pdf_heading" />
            <TextView style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/gs_secondary" android:text="@string/pdf_support" />
            <TextView android:id="@id/pdfPolicy" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/gs_secondary" />
            <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:labelFor="@id/pdfChoose" android:text="@string/pdf_label" />
            <com.google.android.material.button.MaterialButton android:id="@id/pdfChoose" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="start|center_vertical" android:text="@string/pdf_choose" app:cornerRadius="16dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" android:padding="16dp" android:background="@drawable/bg_muted">
                <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pdf_payment_title" />
                <TextView style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/gs_secondary" android:text="@string/pdf_payment_body" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" android:padding="20dp" android:background="@drawable/bg_request_record">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_cash_info" app:tint="@color/gs_text" android:importantForAccessibility="no" />
                <TextView android:id="@id/pdfSelectionTitle" style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/pdf_empty_title" />
                <TextView android:id="@id/pdfName" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
                <TextView android:id="@id/pdfSelectionBody" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/gs_secondary" android:text="@string/pdf_empty_body" />
            </LinearLayout>
            <TextView android:id="@id/pdfReview" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:visibility="gone" />
            <TextView android:id="@id/pdfMessage" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@id/pdfLoading" android:layout_width="match_parent" android:layout_height="56dp" android:importantForAccessibility="no" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@id/pdfReload" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="14dp" android:text="@string/pdf_reload" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@id/pdfEdit" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/pdf_edit" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@id/pdfPrimary" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:text="@string/pdf_review_action" app:cornerRadius="16dp" />
</LinearLayout>
