<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gs_background">
    <LinearLayout android:id="@+id/cashHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/cashBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" android:visibility="gone" />
        <TextView android:id="@+id/cashToolbar" style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="12dp" android:text="@string/cash_toolbar" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/cashScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" app:layout_constraintTop_toBottomOf="@id/cashHeader" app:layout_constraintBottom_toTopOf="@id/cashConfirmHost" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/cashHeading" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cash_find" />
            <TextView android:id="@+id/cashBody" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/gs_secondary" android:text="@string/cash_find_body" />
            <TextView android:id="@+id/cashProgress" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView android:id="@+id/cashConnection" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/cash_live_unavailable" android:visibility="gone" />
            <TextView android:id="@+id/cashReferenceLabel" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:labelFor="@id/cashReferenceInput" android:text="@string/cash_reference_label" />
            <EditText android:id="@+id/cashReferenceInput" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="48dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/bg_teller_input" android:hint="@string/cash_reference_hint" android:inputType="textMultiLine|textNoSuggestions" android:maxLines="3" android:saveEnabled="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cashSearchButton" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:minHeight="48dp" android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:gravity="start|center_vertical" android:text="@string/cash_search" app:cornerRadius="16dp" app:icon="@drawable/ic_search" app:iconSize="24dp" app:iconTint="@color/gs_on_primary" />
            <LinearLayout android:id="@+id/cashAccessNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_muted">
                <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cash_teller_only" />
                <TextView style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/gs_secondary" android:text="@string/cash_teller_body" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cashReceiptNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal" android:visibility="gone">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_request_done" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cash_confirmed_label" />
                    <TextView style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/cash_confirmed_notice" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/cashReviewCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="22dp" android:background="@drawable/bg_teller_receipt" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/cashReviewTitle" style="@style/TextAppearance.GoServe.Heading.Office" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cash_receipt_details" />
                <TextView android:id="@+id/cashReviewReferenceLabel" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/gs_secondary" android:text="@string/cash_reference_label" />
                <TextView android:id="@+id/cashReviewReference" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textIsSelectable="true" />
                <TextView android:id="@+id/cashReviewService" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/gs_secondary" />
                <TextView android:id="@+id/cashReviewAmount" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
                <TextView android:id="@+id/cashReviewStatus" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
                <TextView android:id="@+id/cashReviewActor" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/cash_confirmed_by" android:visibility="gone" />
                <TextView android:id="@+id/cashReviewTime" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:visibility="gone" />
                <TextView android:id="@+id/cashReviewId" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:visibility="gone" />
            </LinearLayout>
            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cashReceivedCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_marginTop="14dp" android:background="@drawable/bg_privacy_choice" android:padding="12dp" android:checked="false" android:saveEnabled="false" android:textAppearance="@style/TextAppearance.GoServe.Body.Small" android:text="@string/cash_received_full" android:textColor="@color/gs_text" app:buttonTint="@color/gs_text" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cashReviewButton" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:minHeight="48dp" android:padding="14dp" android:gravity="start|center_vertical" app:icon="@drawable/ic_cash_check" app:iconSize="24dp" app:iconPadding="8dp" app:iconTint="@color/cash_action_foreground" android:text="@string/cash_review_confirmation" android:textColor="@color/cash_action_foreground" app:backgroundTint="@color/cash_action_background" app:cornerRadius="16dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/cashDuplicateWarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_teller_receipt" android:padding="22dp" android:orientation="vertical" android:visibility="gone">
                <ImageView android:id="@+id/cashDuplicateIcon" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginBottom="10dp" android:src="@drawable/ic_cash_info" app:tint="@color/gs_text" android:importantForAccessibility="no" />
                <TextView android:id="@+id/cashDuplicateTitle" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cash_duplicate_title" />
                <TextView android:id="@+id/cashDuplicateBody" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/gs_secondary" android:text="@string/cash_duplicate_body" />
            </LinearLayout>
            <TextView android:id="@+id/cashError" style="@style/TextAppearance.GoServe.Error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cashCheckStatusButton" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:minHeight="48dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:text="@string/cash_check_status" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cashEditButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="48dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:text="@string/cash_edit_reference" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout android:id="@+id/cashConfirmHost" android:layout_width="0dp" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="14dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/cashConfirmButton" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:enabled="false" android:text="@string/cash_confirm" android:textColor="@color/cash_action_foreground" app:backgroundTint="@color/cash_action_background" app:cornerRadius="16dp" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
