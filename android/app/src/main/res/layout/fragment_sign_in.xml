<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gs_background" android:fillViewport="true" android:clipToPadding="false">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
        <LinearLayout android:id="@+id/accountCard" style="@style/Widget.GoServe.Account.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:padding="20dp" app:layout_constraintWidth_max="@dimen/account_card_max_width" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintVertical_bias="0.5">
            <ImageView android:id="@+id/authLogo" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:src="@drawable/goserve_logo" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/account_signin_title" android:textAppearance="@style/TextAppearance.GoServe.Account.Title" android:gravity="center" />
            <TextView android:id="@+id/subtitle" style="@style/Widget.GoServe.Account.Support" android:layout_marginTop="4dp" android:text="@string/account_signin_intro" android:gravity="center" />
            <TextView android:id="@+id/passwordNoticeText" style="@style/Widget.GoServe.Account.Support" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/googleButton" style="@style/Widget.GoServe.SignIn.Button.Outlined" android:layout_marginTop="16dp" android:text="@string/continue_google" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:importantForAccessibility="no">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/gs_border" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/or" android:textAppearance="@style/TextAppearance.GoServe.Caption" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/gs_border" />
            </LinearLayout>
            <TextView android:id="@+id/emailLabel" style="@style/Widget.GoServe.Account.Label" android:layout_marginTop="12dp" android:text="@string/account_email" android:labelFor="@id/emailInput" />
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/emailInput" style="@style/Widget.GoServe.Account.Input" android:layout_marginTop="4dp" android:hint="@string/account_email_hint" android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
            <TextView android:id="@+id/passwordLabel" style="@style/Widget.GoServe.Account.Label" android:layout_marginTop="12dp" android:text="@string/account_password" android:labelFor="@id/passwordInput" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordBox" style="@style/Widget.GoServe.Account.PasswordBox" android:layout_marginTop="4dp" android:saveEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput" style="@style/Widget.GoServe.Account.PasswordInput" android:hint="@string/account_signin_password_hint" android:imeOptions="actionDone" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/forgotPasswordButton" style="@style/Widget.GoServe.SignIn.Link" android:layout_gravity="end" android:text="@string/account_signin_forgot" />
            <com.google.android.material.button.MaterialButton android:id="@+id/signInButton" style="@style/Widget.GoServe.SignIn.Button" android:layout_marginTop="0dp" android:text="@string/sign_in_logic" />
            <com.google.android.material.button.MaterialButton android:id="@+id/signupTab" style="@style/Widget.GoServe.SignIn.Button.Outlined" android:text="@string/account_signin_create" />
            <TextView android:id="@+id/errorText" style="@style/Widget.GoServe.Account.Error" />
            <com.google.android.material.button.MaterialButton android:id="@+id/retryButton" style="@style/Widget.GoServe.Account.Button.Outlined" android:text="@string/account_retry" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/viewTermsButton" style="@style/Widget.GoServe.SignIn.Link" android:layout_width="0dp" android:layout_weight="1" android:text="@string/account_terms_title" />
                <com.google.android.material.button.MaterialButton android:id="@+id/previewButton" style="@style/Widget.GoServe.SignIn.Link" android:layout_width="0dp" android:layout_weight="1" android:text="@string/preview_design" android:visibility="gone" />
            </LinearLayout>
            <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/account_group_gap" android:visibility="gone" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
