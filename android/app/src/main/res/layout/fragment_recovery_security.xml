<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/gs_background" android:saveEnabled="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
        <ImageButton android:id="@+id/recoveryBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <TextView android:id="@+id/recoveryTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="12dp" android:textAppearance="@style/TextAppearance.GoServe.Heading.Toolbar" android:accessibilityHeading="true" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/recoveryScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/recoveryIntro" style="@style/Widget.GoServe.Account.Support" />
            <TextView android:id="@+id/recoveryStatus" style="@style/Widget.GoServe.Account.Support" android:layout_marginTop="16dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/recoveryCodesPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:saveEnabled="false">
                <LinearLayout android:id="@+id/recoveryCodeRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:saveEnabled="false" />
                <TextView style="@style/Widget.GoServe.Account.Support" android:layout_marginTop="20dp" android:text="@string/recovery_codes_saving" />
            </LinearLayout>
            <LinearLayout android:id="@+id/recoveryProofPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/recoveryEmailLabel" style="@style/Widget.GoServe.Account.Label" android:text="@string/account_email" android:labelFor="@id/recoveryEmail" />
                <androidx.appcompat.widget.AppCompatEditText android:id="@+id/recoveryEmail" style="@style/Widget.GoServe.Account.Input" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:saveEnabled="false" />
            </LinearLayout>
            <TextView android:id="@+id/recoveryProofLabel" style="@style/Widget.GoServe.Account.Label" android:text="@string/recovery_single_code" android:labelFor="@id/recoveryProofInput" android:visibility="gone" />
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/recoveryProofInput" style="@style/Widget.GoServe.Account.Input" android:inputType="textNoSuggestions" android:importantForAutofill="no" android:saveEnabled="false" android:visibility="gone" />
            <LinearLayout android:id="@+id/recoveryPasswordPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:saveEnabled="false">
                <TextView style="@style/Widget.GoServe.Account.Label" android:text="@string/password_new" android:labelFor="@id/recoveryNewPassword" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.GoServe.Account.PasswordBox" android:saveEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/recoveryNewPassword" style="@style/Widget.GoServe.Account.PasswordInput" android:autofillHints="newPassword" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView style="@style/Widget.GoServe.Account.Support" android:text="@string/account_password_rule" />
                <TextView style="@style/Widget.GoServe.Account.Label" android:text="@string/account_password_confirmation" android:labelFor="@id/recoveryConfirmPassword" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.GoServe.Account.PasswordBox" android:saveEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/recoveryConfirmPassword" style="@style/Widget.GoServe.Account.PasswordInput" android:autofillHints="newPassword" android:imeOptions="actionDone" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <TextView android:id="@+id/recoveryNoBypass" style="@style/Widget.GoServe.Account.Support" android:layout_marginTop="20dp" android:text="@string/recovery_no_bypass" />
            <TextView android:id="@+id/recoveryError" style="@style/Widget.GoServe.Account.Error" />
            <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/recoveryProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="16dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/recoveryPrimary" style="@style/Widget.GoServe.Account.Button" />
            <com.google.android.material.button.MaterialButton android:id="@+id/recoveryReauthenticate" style="@style/Widget.GoServe.Account.Button.Text" android:text="@string/recovery_reauthenticate" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
