<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="14dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/consultAppointments" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/consultation_live_appointments" />
    <TextView android:id="@+id/consultHeading" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" />
    <TextView android:id="@+id/consultIntro" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="14dp" android:textColor="@color/gs_secondary" />
    <RadioGroup android:id="@+id/consultOffice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/consultGuidance" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:padding="12dp" android:background="@drawable/bg_input" android:textAppearance="@style/TextAppearance.GoServe.Label" android:textColor="@color/gs_text" android:text="@string/consultation_live_guidance" />
        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/consultDepartment" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:padding="12dp" android:layout_marginTop="14dp" android:background="@drawable/bg_input" android:textAppearance="@style/TextAppearance.GoServe.Label" android:textColor="@color/gs_text" android:text="@string/consultation_live_department" />
    </RadioGroup>
    <TextView android:id="@+id/consultConnection" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/consultation_live_connection" android:visibility="gone" />
    <TextView android:id="@+id/consultProgress" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" android:text="@string/consultation_live_loading" android:visibility="gone" />
    <TextView android:id="@+id/consultError" style="@style/TextAppearance.GoServe.Error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <TextView android:id="@+id/consultNotice" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:accessibilityLiveRegion="polite" android:text="@string/consultation_live_confirmed" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/consultRetry" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/consultation_live_retry" android:visibility="gone" />
    <TextView android:id="@+id/consultEmpty" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:visibility="gone" />
    <TextView android:id="@+id/consultSummary" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="16dp" android:background="@drawable/bg_teller_receipt" android:textIsSelectable="true" android:visibility="gone" />
    <LinearLayout android:id="@+id/consultForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:labelFor="@id/consultStart" android:text="@string/consultation_live_start" />
        <com.google.android.material.button.MaterialButton android:id="@+id/consultStart" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/consultation_live_choose_datetime" />
        <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:labelFor="@id/consultEnd" android:text="@string/consultation_live_end" />
        <com.google.android.material.button.MaterialButton android:id="@+id/consultEnd" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/consultation_live_choose_datetime" />
        <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:labelFor="@id/consultCapacity" android:text="@string/consultation_live_capacity" />
        <EditText android:id="@+id/consultCapacity" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:inputType="number" android:importantForAutofill="no" android:saveEnabled="false" android:maxLength="9" />
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/consultActive" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="14dp" android:textAppearance="@style/TextAppearance.GoServe.Label" android:textColor="@color/gs_text" android:text="@string/consultation_live_active" android:saveEnabled="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/consultReasonGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:labelFor="@id/consultReason" android:text="@string/consultation_live_reason" />
        <EditText android:id="@+id/consultReason" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:inputType="textMultiLine|textCapSentences" android:gravity="top|start" android:importantForAutofill="no" android:saveEnabled="false" android:maxLength="2000" />
    </LinearLayout>
    <TextView android:id="@+id/consultPolicy" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="16dp" android:background="@drawable/bg_teller_receipt" android:text="@string/consultation_live_policy" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/consultPrimary" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/consultMove" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/consultation_live_reschedule" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/consultCancel" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/consultation_live_cancel" android:visibility="gone" />
    <TextView android:id="@+id/consultHistoryHeading" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/consultation_live_history" android:visibility="gone" />
</LinearLayout>
