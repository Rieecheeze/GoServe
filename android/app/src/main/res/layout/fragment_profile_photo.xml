<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gs_background">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/photoToolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/gs_toolbar_height" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/photoBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <TextView android:id="@+id/photoHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="20dp" android:layout_marginVertical="16dp" android:text="@string/profile_photo_title" android:textAppearance="@style/TextAppearance.GoServe.Heading.Toolbar" app:layout_constraintStart_toEndOf="@id/photoBack" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/photoScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/photoToolbar" app:layout_constraintBottom_toTopOf="@id/photoFooter">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/gs_content_margin" android:paddingTop="24dp" android:paddingBottom="24dp">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/photoImage" android:layout_width="128dp" android:layout_height="128dp" android:layout_gravity="center_horizontal" android:background="@drawable/bg_profile_photo" android:scaleType="fitCenter" android:src="@drawable/ic_profile_person" android:contentDescription="@string/profile_photo_empty_description" android:saveEnabled="false" />
            <TextView android:id="@+id/photoStatus" style="@style/Widget.GoServe.Account.Support" android:layout_marginTop="24dp" android:gravity="center" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/photoChoose" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/profile_photo_choose" android:textColor="@color/profile_photo_secondary_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/photoRemove" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/profile_photo_remove" android:textColor="@color/profile_photo_secondary_text" />
            <TextView android:id="@+id/photoError" style="@style/Widget.GoServe.Account.Error" />
            <com.google.android.material.button.MaterialButton android:id="@+id/photoReload" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/profile_photo_reload" android:textColor="@color/profile_photo_secondary_text" />
            <TextView android:id="@+id/photoHelp" style="@style/Widget.GoServe.Account.Support" android:layout_marginTop="24dp" android:text="@string/profile_photo_help" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/photoFooter" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/gs_background" android:paddingHorizontal="@dimen/gs_content_margin" android:paddingVertical="12dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/photoProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/photoSave" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_photo_save" android:textColor="@color/cash_action_foreground" app:backgroundTint="@color/cash_action_background" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
