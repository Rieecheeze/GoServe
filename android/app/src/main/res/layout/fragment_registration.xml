<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gs_background"
    android:fillViewport="true"
    android:clipToPadding="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/gs_auth_margin">
        <LinearLayout
            android:id="@+id/accountCard"
            style="@style/Widget.GoServe.Account.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintWidth_max="@dimen/account_card_max_width"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.5">
            <ImageView android:id="@+id/authLogo" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center_horizontal" android:src="@drawable/goserve_logo" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/account_group_gap" android:text="@string/account_credentials_title" android:textAppearance="@style/TextAppearance.GoServe.Account.Title" android:accessibilityHeading="true" android:gravity="center" />
            <TextView android:id="@+id/subtitle" style="@style/Widget.GoServe.Account.Support" android:layout_marginTop="@dimen/account_group_gap" android:text="@string/account_credentials_intro" android:gravity="center" />
            <TextView android:id="@+id/emailLabel" style="@style/Widget.GoServe.Account.Label" android:text="@string/account_email" android:labelFor="@id/emailInput" />
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/emailInput" style="@style/Widget.GoServe.Account.Input" android:hint="@string/account_email_hint" android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
            <TextView android:id="@+id/emailError" style="@style/Widget.GoServe.Account.Error" />
            <TextView android:id="@+id/emailHelp" style="@style/Widget.GoServe.Account.Support" android:text="@string/account_email_help" />
            <TextView android:id="@+id/passwordLabel" style="@style/Widget.GoServe.Account.Label" android:text="@string/account_password" android:labelFor="@id/passwordInput" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordBox" style="@style/Widget.GoServe.Account.PasswordBox" android:saveEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput" style="@style/Widget.GoServe.Account.PasswordInput" android:hint="@string/account_password_hint" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/passwordError" style="@style/Widget.GoServe.Account.Error" />
            <TextView android:id="@+id/passwordRule" style="@style/Widget.GoServe.Account.Support" android:text="@string/account_password_rule" />
            <TextView android:id="@+id/confirmationLabel" style="@style/Widget.GoServe.Account.Label" android:text="@string/account_password_confirmation" android:labelFor="@id/confirmationInput" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmationBox" style="@style/Widget.GoServe.Account.PasswordBox" android:saveEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/confirmationInput" style="@style/Widget.GoServe.Account.PasswordInput" android:hint="@string/account_password_confirmation_hint" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/confirmationError" style="@style/Widget.GoServe.Account.Error" />
            <TextView android:id="@+id/termsAccepted" style="@style/Widget.GoServe.Account.Support" android:text="@string/account_terms_accepted" />
            <com.google.android.material.button.MaterialButton android:id="@+id/viewTermsButton" style="@style/Widget.GoServe.Account.Button.Text" android:text="@string/account_terms_title" />
            <TextView android:id="@+id/errorText" style="@style/Widget.GoServe.Account.Error" />
            <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/account_group_gap" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/continueButton" style="@style/Widget.GoServe.Account.Button" android:text="@string/account_continue" />
            <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.GoServe.Account.Button.Text" android:text="@string/account_back" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
