<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/gs_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/evidenceBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <TextView style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/evidence_title" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/evidenceScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/evidenceHeading" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/evidence_heading" />
            <TextView style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/gs_secondary" android:text="@string/evidence_support" />
            <TextView android:id="@+id/evidencePolicy" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/gs_secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/evidenceChoose" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:text="@string/evidence_choose" />
            <com.google.android.material.button.MaterialButton android:id="@+id/evidenceCamera" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/evidence_camera" android:visibility="gone" />
            <LinearLayout android:id="@+id/evidenceFile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_request_record" android:visibility="gone">
                <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/evidence_selected" />
                <TextView android:id="@+id/evidenceName" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/gs_secondary" />
            </LinearLayout>
            <TextView android:id="@+id/evidenceStatus" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/evidenceLoading" android:layout_width="match_parent" android:layout_height="56dp" android:importantForAccessibility="no" android:visibility="gone" />
            <LinearLayout android:id="@+id/evidenceError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_request_record" android:visibility="gone">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_cash_info" app:tint="@color/gs_text" android:importantForAccessibility="no" />
                <TextView style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/evidence_failed_heading" />
                <TextView android:id="@+id/evidenceErrorText" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/gs_secondary" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <TextView android:id="@+id/evidenceCameraNotice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_muted" android:text="@string/evidence_camera_unavailable" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/evidenceUse" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:text="@string/evidence_use" android:textColor="@color/cash_action_foreground" app:backgroundTint="@color/cash_action_background" />
</LinearLayout>
