<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="14dp" android:background="@drawable/bg_request_record">
    <TextView android:id="@+id/notificationRowTitle" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/notificationRowTarget" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/gs_secondary" />
    <TextView android:id="@+id/notificationRowTime" style="@style/TextAppearance.GoServe.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/gs_secondary" />
    <com.google.android.material.button.MaterialButton android:id="@+id/notificationRowOpen" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/notification_live_open" />
    <com.google.android.material.button.MaterialButton android:id="@+id/notificationRowAck" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notification_live_ack" />
</LinearLayout>
