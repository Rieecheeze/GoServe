<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/requestDetailBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <TextView android:id="@+id/requestDetailHeading" style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/request_detail_title" />
        <ImageButton android:id="@+id/requestDetailRefresh" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_popup_sync" app:tint="@color/gs_text" android:contentDescription="@string/request_live_detail_refresh" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/requestDetailScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/requestDetailNotice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="@drawable/bg_muted" android:textColor="@color/gs_secondary" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/requestDetailLoading" android:layout_width="match_parent" android:layout_height="56dp" android:importantForAccessibility="no" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/requestDetailRetry" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:text="@string/request_live_retry" android:visibility="gone" />
            <LinearLayout android:id="@+id/requestDetailContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/requestDetailName" style="@style/TextAppearance.GoServe.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
                <TextView android:id="@+id/requestDetailOffice" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/gs_secondary" />
                <TextView android:id="@+id/requestDetailReference" style="@style/TextAppearance.GoServe.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/gs_secondary" android:textIsSelectable="true" />
                <TextView android:id="@+id/requestDetailStatus" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/requestActionOpen" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:text="@string/action_open" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@id/requestEvidenceOpen" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="14dp" android:text="@string/files_toolbar" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@id/requestPdfOpen" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="14dp" android:text="@string/pdf_confirm" android:visibility="gone" />
                <TextView android:id="@+id/requestProgressTitle" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/request_progress_title" />
                <LinearLayout android:id="@+id/requestPhases" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_request_phases" />
                <TextView android:id="@+id/requestFeeTitle" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/request_fee_title" />
                <TextView android:id="@+id/requestFeeDeclaration" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
                <TextView android:id="@+id/requestFeeNote" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/gs_secondary" />
                <TextView android:id="@+id/requestPaymentStatus" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
                <TextView android:id="@+id/requestPaymentNote" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/gs_secondary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/requestEgovpayOpen" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:text="@string/egovpay_open" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/requestFileAction" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:text="@string/request_view_file" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
