<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/gs_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="8dp">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/officeMgmtBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <TextView android:id="@+id/officeMgmtTitle" style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/office_mgmt_office" />
    </LinearLayout>
    <ScrollView android:id="@+id/officeMgmtScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/officeMgmtScope" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/gs_secondary" />
            <TextView android:id="@+id/officeMgmtAudit" style="@style/TextAppearance.GoServe.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/gs_secondary" android:visibility="gone" />
            <ProgressBar android:id="@+id/officeMgmtProgress" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:contentDescription="@string/inquiry_live_loading" />
            <TextView android:id="@+id/officeMgmtError" style="@style/TextAppearance.GoServe.Error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView android:id="@+id/officeMgmtSaved" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:text="@string/office_mgmt_saved" android:visibility="gone" />
            <TextView android:id="@+id/officeMgmtEmpty" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/officeMgmtRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/officeMgmtCreate" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/office_mgmt_new_notice" />
            <LinearLayout android:id="@+id/officeMgmtForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/officeMgmtStatusField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/office_mgmt_status" android:labelFor="@id/officeMgmtStatus" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/officeMgmtStatus" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/office_mgmt_choose_status" />
                </LinearLayout>
                <LinearLayout android:id="@+id/officeMgmtNameField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/office_mgmt_name" android:labelFor="@id/officeMgmtName" />
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/officeMgmtName" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:inputType="textCapSentences" android:maxLength="20000" android:saveEnabled="false" />
                </LinearLayout>
                <LinearLayout android:id="@+id/officeMgmtTextField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
                    <TextView android:id="@+id/officeMgmtTextLabel" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/office_mgmt_note" android:labelFor="@id/officeMgmtText" />
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/officeMgmtText" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:inputType="textCapSentences|textMultiLine" android:gravity="top|start" android:minLines="3" android:maxLength="20000" android:saveEnabled="false" />
                </LinearLayout>
                <LinearLayout android:id="@+id/officeMgmtServiceFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/office_mgmt_delivery" />
                    <CheckBox android:id="@+id/officeMgmtPhysical" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/office_mgmt_physical" android:textAppearance="@style/TextAppearance.GoServe.Body" />
                    <CheckBox android:id="@+id/officeMgmtDigital" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/office_mgmt_digital" android:textAppearance="@style/TextAppearance.GoServe.Body" />
                    <TextView android:id="@+id/officeMgmtModesError" style="@style/TextAppearance.GoServe.Error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/office_mgmt_modes_error" android:visibility="gone" />
                    <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/office_mgmt_requirements" android:labelFor="@id/officeMgmtRequirements" />
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/officeMgmtRequirements" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:inputType="textMultiLine" android:gravity="top|start" android:minLines="2" android:maxLength="20000" android:saveEnabled="false" />
                    <TextView style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/gs_secondary" android:text="@string/office_mgmt_requirements_help" />
                    <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/office_mgmt_fee" android:labelFor="@id/officeMgmtFee" />
                    <RadioGroup android:id="@+id/officeMgmtFee" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <RadioButton android:id="@+id/officeMgmtFeePending" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/office_mgmt_pending" android:textAppearance="@style/TextAppearance.GoServe.Body" />
                        <RadioButton android:id="@+id/officeMgmtFeeFree" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/office_mgmt_free" android:textAppearance="@style/TextAppearance.GoServe.Body" />
                        <RadioButton android:id="@+id/officeMgmtFeeRequired" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/office_mgmt_required" android:textAppearance="@style/TextAppearance.GoServe.Body" />
                    </RadioGroup>
                    <LinearLayout android:id="@+id/officeMgmtMoney" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/office_mgmt_amount" android:labelFor="@id/officeMgmtAmount" />
                        <androidx.appcompat.widget.AppCompatEditText android:id="@+id/officeMgmtAmount" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:inputType="numberDecimal" android:maxLength="20000" android:saveEnabled="false" />
                        <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/office_mgmt_currency" android:labelFor="@id/officeMgmtCurrency" />
                        <androidx.appcompat.widget.AppCompatEditText android:id="@+id/officeMgmtCurrency" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:inputType="textCapCharacters" android:maxLength="20000" android:saveEnabled="false" />
                    </LinearLayout>
                    <TextView android:id="@+id/officeMgmtDemo" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/office_mgmt_demo" android:textColor="@color/gs_secondary" />
                </LinearLayout>
                <CheckBox android:id="@+id/officeMgmtActive" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minHeight="48dp" android:text="@string/office_mgmt_active_notice" android:textAppearance="@style/TextAppearance.GoServe.Body" />
            </LinearLayout>
            <TextView android:id="@+id/officeMgmtSummary" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="16dp" android:background="@drawable/bg_request_record" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/officeMgmtPrimary" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/office_mgmt_review" />
            <com.google.android.material.button.MaterialButton android:id="@+id/officeMgmtEdit" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/office_mgmt_edit" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/officeMgmtCancel" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/office_mgmt_cancel" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/officeMgmtMore" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/office_mgmt_more" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/officeMgmtRefresh" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/office_mgmt_refresh" />
            <com.google.android.material.button.MaterialButton android:id="@+id/officeMgmtDiscard" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/office_mgmt_discard" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
