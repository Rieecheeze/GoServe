<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/liveRequestTitle" style="@style/TextAppearance.GoServe.Heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/request_live_title" />
        <ImageButton android:id="@+id/liveRequestRefresh" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_popup_sync" app:tint="@color/gs_text" android:contentDescription="@string/request_live_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/liveRequestSupport" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/gs_secondary" android:text="@string/request_live_support" />
    <TextView android:id="@+id/liveRequestSection" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:text="@string/request_live_section" android:visibility="gone" />
    <HorizontalScrollView android:id="@+id/queueFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fillViewport="false" android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/queueAll" style="@style/Widget.GoServe.Button.Filter.Stateful" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/queue_all" />
            <com.google.android.material.button.MaterialButton android:id="@+id/queueSubmitted" style="@style/Widget.GoServe.Button.Filter.Stateful" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="8dp" android:text="@string/queue_submitted" />
            <com.google.android.material.button.MaterialButton android:id="@+id/queueProcessing" style="@style/Widget.GoServe.Button.Filter.Stateful" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="8dp" android:text="@string/queue_processing" />
            <com.google.android.material.button.MaterialButton android:id="@+id/queueReady" style="@style/Widget.GoServe.Button.Filter.Stateful" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="8dp" android:text="@string/queue_ready" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView android:id="@+id/liveRequestProgress" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/request_live_loading" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <ph.edu.tip.goserve.ui.BrandLoadingView android:id="@+id/liveRequestLoading" android:layout_width="match_parent" android:layout_height="56dp" android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:id="@+id/liveRequestConnection" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/request_live_connection" android:visibility="gone" />
    <TextView android:id="@+id/liveRequestError" style="@style/TextAppearance.GoServe.Error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/liveRequestRetry" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/request_live_retry" android:visibility="gone" />
    <LinearLayout android:id="@+id/liveRequestEmpty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="24dp" android:paddingBottom="24dp" android:visibility="gone">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_request_empty" app:tint="@color/gs_secondary" android:importantForAccessibility="no" />
        <TextView android:id="@+id/liveRequestEmptyTitle" style="@style/TextAppearance.GoServe.Heading.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/request_live_empty_title" />
        <TextView android:id="@+id/liveRequestEmptyBody" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:textColor="@color/gs_secondary" android:text="@string/request_live_empty_body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/liveRequestBrowse" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:text="@string/request_live_browse" app:cornerRadius="1000dp" />
    </LinearLayout>
</LinearLayout>
