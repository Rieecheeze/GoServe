<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/gs_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="12dp">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/inquiryThreadBack" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/inquiry_live_back" />
        <TextView android:id="@+id/inquiryThreadTitle" style="@style/TextAppearance.GoServe.Heading.Toolbar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/inquiry_live_new" />
    </LinearLayout>
    <ScrollView android:id="@+id/inquiryThreadScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <ProgressBar android:id="@+id/inquiryThreadProgress" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:contentDescription="@string/inquiry_live_loading" />
            <TextView android:id="@+id/inquiryThreadError" style="@style/TextAppearance.GoServe.Error" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView android:id="@+id/inquiryThreadConnection" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/inquiry_live_connection" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/inquiryThreadRetry" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/inquiry_live_retry" android:visibility="gone" />
            <LinearLayout android:id="@+id/inquiryOfficeField" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/inquiryOfficeSelect" android:text="@string/inquiry_live_office" />
                <com.google.android.material.button.MaterialButton android:id="@+id/inquiryOfficeSelect" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/inquiry_live_select_office" />
            </LinearLayout>
            <LinearLayout android:id="@+id/inquiryThreadNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" android:padding="16dp" android:background="@drawable/bg_request_phases">
                <TextView android:id="@+id/inquiryThreadRecipient" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/inquiry_live_recipient" />
                <TextView android:id="@+id/inquiryThreadScope" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/gs_secondary" android:text="@string/inquiry_live_recipient_body" />
            </LinearLayout>
            <TextView android:id="@+id/inquiryAssignment" style="@style/TextAppearance.GoServe.Body.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/inquiry_live_assignment_body" android:visibility="gone" />
            <TextView android:id="@+id/inquiryThreadIdentity" style="@style/TextAppearance.GoServe.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/gs_secondary" />
            <LinearLayout android:id="@+id/inquiryMessageRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/inquiryMessageMore" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/inquiry_live_more_messages" android:visibility="gone" />
            <TextView android:id="@+id/inquiryMessageLabel" style="@style/TextAppearance.GoServe.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:labelFor="@id/inquiryMessageInput" android:text="@string/inquiry_live_message" />
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/inquiryMessageInput" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="@string/inquiry_live_message_hint" android:inputType="textCapSentences|textMultiLine" android:gravity="top|start" android:minLines="2" android:maxLength="20000" android:saveEnabled="false" />
            <TextView android:id="@+id/inquirySending" style="@style/TextAppearance.GoServe.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/inquiry_live_sending_body" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton android:id="@+id/inquirySend" style="@style/Widget.GoServe.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/inquiry_live_send" />
            <com.google.android.material.button.MaterialButton android:id="@+id/inquiryThreadRefresh" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/inquiry_live_refresh" />
            <com.google.android.material.button.MaterialButton android:id="@+id/inquiryDiscard" style="@style/Widget.GoServe.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/inquiry_live_discard" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
