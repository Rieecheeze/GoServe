<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gs_background">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/assistantHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/backButton" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <ph.edu.tip.goserve.ui.common.SeryoMascotView android:id="@+id/seryoIcon" android:layout_width="36dp" android:layout_height="40dp" android:visibility="gone" android:importantForAccessibility="no" app:seryoState="idle" app:seryoCompact="true" app:layout_constraintStart_toEndOf="@id/backButton" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/panelTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="8dp" android:text="@string/seryo_name" android:textAppearance="@style/TextAppearance.GoServe.Heading.Toolbar" app:layout_goneMarginStart="0dp" app:layout_constraintStart_toEndOf="@id/seryoIcon" app:layout_constraintEnd_toStartOf="@id/privacyButton" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/providerCaption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/seryo_role" android:textAppearance="@style/TextAppearance.GoServe.Caption" android:accessibilityLiveRegion="polite" app:layout_constraintStart_toStartOf="@id/panelTitle" app:layout_constraintEnd_toEndOf="@id/panelTitle" app:layout_constraintTop_toBottomOf="@id/panelTitle" />
        <ImageButton android:id="@+id/privacyButton" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_seryo_privacy" app:tint="@color/gs_secondary" android:contentDescription="@string/seryo_privacy" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.widget.Barrier android:id="@+id/assistantHeaderBottom" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="backButton,seryoIcon,providerCaption,privacyButton" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/assistantScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/assistantHeader" app:layout_constraintBottom_toTopOf="@id/composerHost">
        <LinearLayout android:id="@+id/assistantContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="16dp">
            <LinearLayout android:id="@+id/accessNotice" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="@drawable/bg_muted" android:visibility="gone">
                <TextView android:id="@+id/accessTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seryo_pending_title" android:textAppearance="@style/TextAppearance.GoServe.Label" />
                <TextView android:id="@+id/accessBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_pending_body" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reviewPrivacyButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_privacy" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/retryReadinessButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_refresh" android:visibility="gone" />
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/chatPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <ph.edu.tip.goserve.ui.common.SeryoMascotView android:id="@+id/seryoBubbleAvatar" android:layout_width="36dp" android:layout_height="40dp" android:importantForAccessibility="no" app:seryoState="idle" app:seryoCompact="true" app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="@id/welcomeCard" />
                <LinearLayout android:id="@+id/welcomeCard" app:layout_constraintWidth_max="350dp" app:layout_constraintHorizontal_bias="0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:background="@drawable/bg_seryo_response" app:layout_constraintStart_toEndOf="@id/seryoBubbleAvatar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                    <TextView android:id="@+id/chatHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seryo_hero" android:textAppearance="@style/TextAppearance.GoServe.Heading.Section" android:gravity="center" />
                    <TextView android:id="@+id/chatIntro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_intro" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" android:gravity="center" />
                </LinearLayout>
                <LinearLayout android:id="@+id/chatTranscript" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:saveEnabled="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/welcomeCard" />
                <LinearLayout android:id="@+id/inlineAttachment" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_muted" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/chatTranscript">
                    <TextView android:id="@+id/selectedFileText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.GoServe.Label" android:saveEnabled="false" />
                    <TextView android:id="@+id/operationText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" android:saveEnabled="false" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/serviceFileButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_document_services" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/removeAttachmentButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seryo_remove_local" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/consentPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="16dp">
            <TextView android:id="@+id/privacyHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/seryo_privacy_heading" android:textAppearance="@style/TextAppearance.GoServe.Heading" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:id="@+id/privacyBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_privacy_body" android:textAppearance="@style/TextAppearance.GoServe.Body" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/privacyHeading" />
            <TextView android:id="@+id/guidanceText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_guidance" android:textAppearance="@style/TextAppearance.GoServe.Body" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/privacyBody" />
            <TextView android:id="@+id/retentionText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_retention" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/guidanceText" />
            <TextView android:id="@+id/consentPending" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/seryo_consent_pending" android:textAppearance="@style/TextAppearance.GoServe.Label" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/retentionText" />
            <com.google.android.material.button.MaterialButton android:id="@+id/allowAiButton" style="@style/Widget.GoServe.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_allow" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/consentPending" />
            <com.google.android.material.button.MaterialButton android:id="@+id/declineAiButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_decline" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/allowAiButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/revokeAiButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_revoke" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/declineAiButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/returnToChatButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_back_chat" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/revokeAiButton" app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout android:id="@+id/supportPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="16dp">
            <TextView android:id="@+id/supportHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.GoServe.Heading.Section" />
            <TextView android:id="@+id/supportBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="@style/TextAppearance.GoServe.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/withdrawAiButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" android:text="@string/seryo_revoke" />
            <com.google.android.material.button.MaterialButton android:id="@+id/privacySettingsButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_privacy" />
            <com.google.android.material.button.MaterialButton android:id="@+id/helpSettingsButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_help_title" />
            <com.google.android.material.button.MaterialButton android:id="@+id/refreshStateButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_refresh" />
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/attachmentPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="16dp">
            <TextView android:id="@+id/attachmentHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/seryo_attachment_heading" android:textAppearance="@style/TextAppearance.GoServe.Heading" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:id="@+id/attachmentBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_attachment_body" android:textAppearance="@style/TextAppearance.GoServe.Body" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/attachmentHeading" />
            <com.google.android.material.button.MaterialButton android:id="@+id/chooseFileButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:enabled="false" android:text="@string/seryo_choose_file" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/attachmentBody" />
            <TextView android:id="@+id/noUploadText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_no_upload" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/chooseFileButton" />
            <TextView android:id="@+id/cleanupText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/seryo_cleanup_plan" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/noUploadText" app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/composerHost" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_seryo_composer">
            <EditText android:id="@+id/questionInput" style="@style/Widget.GoServe.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:minLines="@integer/seryo_draft_min_lines" android:maxLines="@integer/seryo_draft_max_lines" android:ellipsize="end" android:scrollbars="vertical" android:padding="0dp" android:background="@null" android:gravity="top" android:inputType="textCapSentences|textMultiLine" android:maxLength="2000" android:saveEnabled="false" android:hint="@string/seryo_question_hint" android:contentDescription="@string/seryo_question_label" />
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp">
                <ImageButton android:id="@+id/attachmentButton" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_seryo_tools" android:contentDescription="@string/seryo_tools" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <ImageButton android:id="@+id/sendButton" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_seryo_send" app:tint="@color/gs_secondary" android:background="@drawable/bg_seryo_send" android:enabled="false" android:contentDescription="@string/seryo_send" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <TextView android:id="@+id/composerDisclaimer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_not_sent" android:textAppearance="@style/TextAppearance.GoServe.Caption" android:gravity="center" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>




