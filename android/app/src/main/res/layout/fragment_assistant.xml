<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:background="@color/gs_background">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/gs_content_margin" android:paddingEnd="@dimen/gs_content_margin" android:paddingTop="16dp" android:paddingBottom="24dp">
        <ImageButton android:id="@+id/backButton" style="@style/Widget.GoServe.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <ImageView android:id="@+id/seryoIcon" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_assistant" android:importantForAccessibility="no" app:tint="@color/gs_text" app:layout_constraintStart_toEndOf="@id/backButton" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/panelTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/seryo_name" android:textAppearance="@style/TextAppearance.GoServe.Heading.Toolbar" app:layout_constraintStart_toEndOf="@id/seryoIcon" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/seryoIcon" />
        <androidx.constraintlayout.widget.Barrier android:id="@+id/assistantHeaderBottom" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="backButton,seryoIcon,panelTitle" />
        <TextView android:id="@+id/providerCaption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/seryo_role" android:textAppearance="@style/TextAppearance.GoServe.Caption" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/assistantHeaderBottom" />
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/accessNotice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="16dp" android:background="@drawable/bg_muted" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/providerCaption">
            <TextView android:id="@+id/accessTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/seryo_pending_title" android:textAppearance="@style/TextAppearance.GoServe.Label" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:id="@+id/accessBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_pending_body" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/accessTitle" app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/chatPanel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="28dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/accessNotice" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintVertical_bias="0">
            <TextView android:id="@+id/chatHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/seryo_hero" android:textAppearance="@style/TextAppearance.GoServe.Heading" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:id="@+id/chatIntro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/seryo_intro" android:textAppearance="@style/TextAppearance.GoServe.Body" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/chatHeading" />
            <TextView android:id="@+id/questionLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:labelFor="@id/questionInput" android:text="@string/seryo_question_label" android:textAppearance="@style/TextAppearance.GoServe.Label" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/chatIntro" />
            <EditText android:id="@+id/questionInput" style="@style/Widget.GoServe.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:minLines="3" android:gravity="top" android:inputType="textCapSentences|textMultiLine" android:maxLength="2000" android:saveEnabled="false" android:hint="@string/seryo_question_hint" android:layout_marginTop="8dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/questionLabel" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sendButton" style="@style/Widget.GoServe.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:enabled="false" android:text="@string/seryo_send" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/questionInput" />
            <com.google.android.material.button.MaterialButton android:id="@+id/attachmentButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/seryo_attachment" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/sendButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/privacyButton" style="@style/Widget.GoServe.Button.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/seryo_privacy" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/attachmentButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/officeButton" style="@style/Widget.GoServe.Button.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/seryo_offices" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/privacyButton" app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/consentPanel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/accessNotice" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintVertical_bias="0">
            <TextView android:id="@+id/privacyHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/seryo_privacy_heading" android:textAppearance="@style/TextAppearance.GoServe.Heading" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:id="@+id/privacyBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_privacy_body" android:textAppearance="@style/TextAppearance.GoServe.Body" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/privacyHeading" />
            <TextView android:id="@+id/guidanceText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_guidance" android:textAppearance="@style/TextAppearance.GoServe.Body" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/privacyBody" />
            <TextView android:id="@+id/retentionText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_retention" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/guidanceText" />
            <TextView android:id="@+id/consentPending" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/seryo_consent_pending" android:textAppearance="@style/TextAppearance.GoServe.Label" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/retentionText" />
            <com.google.android.material.button.MaterialButton android:id="@+id/returnToChatButton" style="@style/Widget.GoServe.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/seryo_back_chat" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/consentPending" app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/attachmentPanel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/accessNotice" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintVertical_bias="0">
            <TextView android:id="@+id/attachmentHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/seryo_attachment_heading" android:textAppearance="@style/TextAppearance.GoServe.Heading" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:id="@+id/attachmentBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_attachment_body" android:textAppearance="@style/TextAppearance.GoServe.Body" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/attachmentHeading" />
            <com.google.android.material.button.MaterialButton android:id="@+id/chooseFileButton" style="@style/Widget.GoServe.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:enabled="false" android:text="@string/seryo_choose_file" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/attachmentBody" />
            <TextView android:id="@+id/noUploadText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seryo_no_upload" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/chooseFileButton" />
            <TextView android:id="@+id/cleanupText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/seryo_cleanup_plan" android:textAppearance="@style/TextAppearance.GoServe.Body.Secondary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/noUploadText" app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
