<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.GoServe.Account.Title" parent="TextAppearance.GoServe.Heading">
        <item name="android:gravity">center</item>
    </style>
    <style name="Widget.GoServe.Account.Card" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/account_card_padding</item>
        <item name="android:background">@drawable/bg_account_card</item>
        <item name="android:elevation">8dp</item>
    </style>
    <style name="Widget.GoServe.Account.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/account_group_gap</item>
        <item name="android:textAppearance">@style/TextAppearance.GoServe.Label</item>
    </style>
    <style name="Widget.GoServe.Account.Support" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/account_field_gap</item>
        <item name="android:textAppearance">@style/TextAppearance.GoServe.Body.Secondary</item>
    </style>
    <style name="Widget.GoServe.Account.Error" parent="Widget.GoServe.Account.Support">
        <item name="android:textColor">@color/gs_error</item>
        <item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="Widget.GoServe.Account.Section" parent="Widget.GoServe.Account.Label">
        <item name="android:textAppearance">@style/TextAppearance.GoServe.Heading.Office</item>
        <item name="android:textColor">@color/gs_secondary</item>
    </style>
    <style name="Widget.GoServe.Account.Input" parent="Widget.GoServe.Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/account_field_gap</item>
        <item name="android:background">@drawable/bg_account_input</item>
        <item name="android:minHeight">@dimen/gs_touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
    <style name="Widget.GoServe.Account.ReadOnly" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/account_field_gap</item>
        <item name="android:background">@drawable/bg_account_read_only</item>
        <item name="android:minHeight">@dimen/gs_touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.GoServe.Body</item>
        <item name="android:textColor">@color/gs_secondary</item>
        <item name="android:textIsSelectable">true</item>
    </style>
    <style name="Widget.GoServe.Account.PasswordBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/account_field_gap</item>
        <item name="android:saveEnabled">false</item>
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/gs_surface</item>
        <item name="boxStrokeColor">@color/account_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/account_input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/account_input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/account_input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/account_input_radius</item>
        <item name="endIconMode">password_toggle</item>
        <item name="endIconTint">@color/gs_text</item>
        <item name="endIconContentDescription">@string/account_password_visibility</item>
    </style>
    <style name="Widget.GoServe.Account.PasswordInput" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/gs_touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.GoServe.Body</item>
        <item name="android:textColorHint">@color/gs_secondary</item>
        <item name="android:inputType">textPassword</item>
        <item name="android:singleLine">true</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
    <style name="Widget.GoServe.Account.Button" parent="Widget.GoServe.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/account_group_gap</item>
        <item name="android:minHeight">@dimen/gs_touch_target</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">@dimen/account_action_radius</item>
    </style>
    <style name="Widget.GoServe.Account.Button.Outlined" parent="Widget.GoServe.Account.Button">
        <item name="android:textColor">@color/gs_text</item>
        <item name="backgroundTint">@color/gs_surface</item>
        <item name="strokeColor">@color/gs_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.GoServe.Account.Button.Text" parent="Widget.GoServe.Button.Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/account_group_gap</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
